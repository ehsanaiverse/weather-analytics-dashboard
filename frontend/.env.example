# Frontend environment variables.
#
# Copy to `.env.local` and adjust if needed:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_ are exposed to the browser, and they are
# inlined at BUILD time - changing one requires restarting `npm run dev` or
# rebuilding with `npm run build`. Never put a secret here: everything in a
# VITE_* variable ends up in the JavaScript bundle shipped to the browser.
#
# This project talks to an unauthenticated, key-less Open-Meteo backend, so
# there are no credentials to configure.

# Base URL of the FastAPI backend, including its `/api` prefix.
# The default is a relative path, which the Vite dev server proxies to the
# backend (see vite.config.ts) - that keeps everything same-origin in
# development, so CORS never gets in the way.
VITE_API_BASE_URL=/api

# Target the dev-server proxy forwards `/api` to.
# Used only by vite.config.ts; it is not exposed to the browser bundle.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=20000